---
function flow(seed: number, count: number, steps: number, len: number): string {
  let s = seed;
  const rnd = () => {
    s = (s * 16807) % 2147483647;
    return s / 2147483647;
  };
  let d = '';
  for (let i = 0; i < count; i++) {
    let x = rnd() * 560 - 20;
    let y = rnd() * 600 - 20;
    d += `M${x.toFixed(1)} ${y.toFixed(1)}`;
    for (let k = 0; k < steps; k++) {
      const a =
        Math.sin(x * 0.011) * 1.4 +
        Math.cos(y * 0.013) * 1.3 +
        Math.sin((x - y) * 0.006) * 0.8;
      x += Math.cos(a) * len;
      y += Math.sin(a) * len;
      d += `L${x.toFixed(1)} ${y.toFixed(1)}`;
    }
  }
  return d;
}

const base = flow(12345, 220, 14, 6);
const accent = flow(987, 14, 30, 6);
---

<svg
  class="flow-field"
  viewBox="0 0 520 560"
  width="520"
  height="560"
  aria-hidden="true"
  focusable="false"
>
  <path class="flow-field__base" d={base} />
  <path class="flow-field__accent" d={accent} />
</svg>
